      "type": "table",
      "title": "Server spans",
      "description": "Recent inbound HTTP requests (span kind = server). Click a trace ID to open the whole trace.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 11
