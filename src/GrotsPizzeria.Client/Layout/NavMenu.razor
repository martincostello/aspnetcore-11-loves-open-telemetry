@inject ApiClient Api

<ul class="nav-list">
    <li><NavItem Href="" Label="Home" IconName="home" Exact="true" /></li>
    <li><NavItem Href="menu" Label="Menu" IconName="menu" /></li>
    <li><NavItem Href="cart" Label="Cart" IconName="cart" /></li>
    <li><NavItem Href="orders" Label="My orders" IconName="orders" /></li>

    <li class="nav-divider" aria-hidden="true"></li>
    @if (_telemetryUrl is not null)
    {
        <li>
            <a class="nav-item" href="@_telemetryUrl" target="_blank" rel="noopener" title="Opens in a new tab" aria-label="See telemetry in @_provider (opens in a new tab)">
                <Icon Name="telemetry" /><span>See telemetry</span>
                <span class="nav-trailing" aria-hidden="true">
                    <img class="nav-provider" src="@ProviderLogo" alt="" data-testid="telemetry-provider" data-provider="@_provider" />
                    <span class="nav-external"><Icon Name="external" /></span>
                </span>
            </a>
        </li>
    }
    <li>
        <a class="nav-item" href="@RepositoryUrl" target="_blank" rel="noopener" title="Opens in a new tab" aria-label="View on GitHub (opens in a new tab)">
            <Icon Name="github" /><span>View on GitHub</span>
            <span class="nav-trailing" aria-hidden="true">
                <span class="nav-external"><Icon Name="external" /></span>
            </span>
        </a>
    </li>
</ul>

@code {
    private const string RepositoryUrl = "https://github.com/martincostello/aspnetcore-11-loves-open-telemetry";

    private string? _telemetryUrl;
    private TelemetryProvider _provider;

    // The logo of the product that the link goes to
    private string ProviderLogo => _provider is TelemetryProvider.Aspire ? "img/lang/aspire.svg" : "img/lang/grafana.svg";

    protected override async Task OnInitializedAsync()
    {
        var config = (await Api.GetConfigAsync()).Value;
        _telemetryUrl = config?.TelemetryUrl;
        _provider = config?.TelemetryProvider ?? TelemetryProvider.Grafana;
    }
}
