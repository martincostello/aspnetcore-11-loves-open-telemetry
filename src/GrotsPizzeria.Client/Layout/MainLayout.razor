@inherits LayoutComponentBase
@implements IDisposable
@inject CartState Cart
@inject ApiClient Api
@inject CookieAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<a class="skip-link" href="#main" @onclick="SkipToContentAsync" @onclick:preventDefault>Skip to main content</a>

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="" aria-label="Grot's Pizzeria, home">
            <GrotLogo Size="34" />
            <span class="brand-name">Grot's Pizzeria</span>
        </a>

        <div class="topbar-actions">
            <a class="icon-button @(Cart.Count > 0 ? "prominent" : "")" href="cart" title="@(Cart.Count > 0 ? "Checkout" : "Cart")" aria-label="@CartLabel">
                <Icon Name="cart" />
                @if (Cart.Count > 0)
                {
                    <span class="checkout-label" aria-hidden="true">Checkout</span>
                    <span class="badge-count" aria-hidden="true">@Cart.Count</span>
                }
            </a>
            <span class="visually-hidden" role="status">@(Cart.Count == 0 ? "" : $"{Cart.Count} {(Cart.Count == 1 ? "item" : "items")} in your cart")</span>

            <ThemePicker />

            <AuthorizeView>
                <Authorized>
                    <span class="user-chip" title="Signed in as @context.User.Identity?.Name">
                        <Icon Name="user" /> <span class="visually-hidden">Signed in as </span>@context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                    </span>
                    <button class="btn btn-secondary btn-sm" @onclick="LogoutAsync">Sign out</button>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-secondary btn-sm" href="login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <nav class="sidebar" aria-label="Main">
        <NavMenu />
    </nav>

    <main class="content" id="main" tabindex="-1" @ref="_main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">🗙</button>
</div>

@code {
    private ElementReference _main;

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    private async Task SkipToContentAsync() => await _main.FocusAsync();

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await Api.LogoutAsync();
        Cart.Clear();
        AuthState.Refresh();
        Navigation.NavigateTo("");
    }

    // The accessible name contains the visible text ("Checkout") and says what is in the basket
    private string CartLabel => Cart.Count == 0 ? "Cart" : $"Checkout, {Cart.Count} {(Cart.Count == 1 ? "item" : "items")} in your cart";

    public void Dispose() => Cart.Changed -= OnCartChanged;
}
